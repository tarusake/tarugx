#[test(uart_tx_sends_8n1_frame)]
module uart_tx_sends_8n1_frame {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var in_valid: logic   ;
    var in_ready: logic   ;
    var in_data : logic<8>;
    var tx      : logic   ;

    inst dut: uart_tx #(
        CLKS_PER_BIT: 2,
    ) (
        clk          ,
        rst_n   : rst,
        in_valid     ,
        in_ready     ,
        in_data      ,
        tx           ,
    );

    initial {
        in_valid = 1'b0;
        in_data  = 8'ha5;
        rst.assert();
        clk.next(1);
        $assert(in_ready);
        $assert(tx);

        in_valid = 1'b1;
        clk.next(1);
        in_valid = 1'b0;
        $assert(!in_ready);

        // Start, 0xa5 LSB first, then stop. Each bit lasts two clocks.
        $assert(tx == 1'b0);
        clk.next(2);
        $assert(tx == 1'b1);
        clk.next(2);
        $assert(tx == 1'b0);
        clk.next(2);
        $assert(tx == 1'b1);
        clk.next(2);
        $assert(tx == 1'b0);
        clk.next(2);
        $assert(tx == 1'b0);
        clk.next(2);
        $assert(tx == 1'b1);
        clk.next(2);
        $assert(tx == 1'b0);
        clk.next(2);
        $assert(tx == 1'b1);
        clk.next(2);
        $assert(tx == 1'b1);
        clk.next(2);

        $assert(in_ready);
        $assert(tx);
        $finish();
    }
}
