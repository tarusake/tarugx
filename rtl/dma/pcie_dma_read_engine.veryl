// SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1
/// Two-outstanding PCIe host-memory to VRAM DMA read engine.
///
/// Requests are split at 64-byte Read Completion Boundaries and may contain up
/// to sixteen DWORDs. Two tags may be active concurrently; Completion chunks
/// are associated with their request slot and written through the 256-bit VRAM
/// path. Completion packets may arrive in either tag order.
module pcie_dma_read_engine #(
    param TIMEOUT_CYCLES: u32 = 1000000,
) (
    clk             : input  clock     ,
    rst_n           : input  reset     ,
    cmd_valid       : input  logic     ,
    cmd_ready       : output logic     ,
    cmd_host_address: input  logic<64> ,
    cmd_vram_address: input  logic<32> ,
    cmd_length_bytes: input  logic<32> ,
    busy            : output logic     ,
    done            : output logic     ,
    error           : output logic     ,
    mrd_valid       : output logic     ,
    mrd_ready       : input  logic     ,
    mrd_host_address: output logic<64> ,
    mrd_length_dw   : output logic<5>  ,
    mrd_tag         : output logic<8>  ,
    active0_valid   : output logic     ,
    active0_tag     : output logic<8>  ,
    active1_valid   : output logic     ,
    active1_tag     : output logic<8>  ,
    cpl_valid       : input  logic     ,
    cpl_ready       : output logic     ,
    cpl_has_data    : input  logic     ,
    cpl_error       : input  logic     ,
    cpl_length_dw   : input  logic<4>  ,
    cpl_lower_address: input logic<7>  ,
    cpl_tag         : input  logic<8>  ,
    cpl_data        : input  logic<256>,
    fb_req_valid    : output logic     ,
    fb_req_ready    : input  logic     ,
    fb_req_addr     : output logic<32> ,
    fb_req_wdata    : output logic<256>,
    fb_req_wstrb    : output logic<32> ,
    fb_rsp_valid    : input  logic     ,
    fb_rsp_ready    : output logic     ,
    fb_rsp_error    : input  logic     ,
) {
    enum State: logic<3> {
        Idle,
        Validate,
        Run,
        Finish,
        Fail,
    }
    var state             : State     ;
    var issue_host        : logic<64> ;
    var issue_vram        : logic<32> ;
    var length_bytes      : logic<32> ;
    var issue_remaining_dw: logic<30> ;
    var next_tag          : logic<8>  ;
    var slot_valid        : logic<2>  ;
    var slot_tag          : logic<8>  [2];
    var slot_host         : logic<64> [2];
    var slot_vram         : logic<32> [2];
    var slot_length       : logic<5>  [2];
    var slot_done         : logic<5>  [2];
    var chunk_pending     : logic     ;
    var chunk_slot        : logic     ;
    var chunk_words       : logic<256>;
    var chunk_left        : logic<4>  ;
    var chunk_total       : logic<4>  ;
    var chunk_index       : logic<4>  ;
    var write_vram        : logic<32> ;
    var fb_outstanding    : logic<4>  ;
    var timeout_counter   : logic<32> ;

    let rcb_space_bytes: logic<7> = 7'd64 - {1'b0, issue_host[5:0]};
    let rcb_space_dw   : logic<5> = rcb_space_bytes[6:2];
    let next_request_dw: logic<5> = if issue_remaining_dw <: (rcb_space_dw as 30) ?
        (issue_remaining_dw[4:0] as 5) : rcb_space_dw;
    let command_end: logic<33> = (issue_vram as 33) + (length_bytes as 33);
    let command_ok: logic = (issue_host[1:0] == 0) && (issue_vram[1:0] == 0)
        && (length_bytes != 0) && (length_bytes[1:0] == 0)
        && (command_end <= 33'h00400000)
        && ((issue_host + (length_bytes as 64)) >= issue_host);
    let issue_slot: logic = slot_valid[0];
    let slot_available: logic = !(&slot_valid);
    let tag_available: logic = !(slot_valid[0] && (slot_tag[0] == next_tag))
        && !(slot_valid[1] && (slot_tag[1] == next_tag));
    let issue_possible: logic = (state == State::Run) && (issue_remaining_dw != 0)
        && slot_available && tag_available;
    let cpl_match0: logic = slot_valid[0] && (slot_tag[0] == cpl_tag);
    let cpl_match1: logic = slot_valid[1] && (slot_tag[1] == cpl_tag);
    let cpl_slot: logic = !cpl_match0;
    let expected_address0: logic<64> = slot_host[0] + ((slot_done[0] as 64) << 2);
    let expected_address1: logic<64> = slot_host[1] + ((slot_done[1] as 64) << 2);
    let cpl_expected_lower: logic<7> = if cpl_slot ? expected_address1[6:0] : expected_address0[6:0];
    let cpl_remaining0: logic<6> = (slot_length[0] as 6) - (slot_done[0] as 6);
    let cpl_remaining1: logic<6> = (slot_length[1] as 6) - (slot_done[1] as 6);
    let cpl_remaining: logic<6> = if cpl_slot ? cpl_remaining1 : cpl_remaining0;
    let cpl_vram0: logic<32> = slot_vram[0] + ((slot_done[0] as 32) << 2);
    let cpl_vram1: logic<32> = slot_vram[1] + ((slot_done[1] as 32) << 2);
    let shifted_words: logic<256> = chunk_words >> ((chunk_index as 8) * 8'd32);
    let write_word_count: logic<4> = if (write_vram[4:0] == 0) && (chunk_left >= 4'd8) ?
        4'd8
    : if (write_vram[2:0] == 0) && (chunk_left >= 4'd2) ?
        4'd2
    :
        4'd1
    ;
    let progress: logic = (mrd_valid && mrd_ready) || (cpl_valid && cpl_ready)
        || (fb_req_valid && fb_req_ready) || (fb_rsp_valid && fb_rsp_ready);

    assign active0_valid    = slot_valid[0];
    assign active0_tag      = slot_tag[0];
    assign active1_valid    = slot_valid[1];
    assign active1_tag      = slot_tag[1];
    assign cmd_ready        = state == State::Idle;
    assign busy             = state != State::Idle;
    assign mrd_valid        = issue_possible;
    assign mrd_host_address = issue_host;
    assign mrd_length_dw    = next_request_dw;
    assign mrd_tag          = next_tag;
    assign cpl_ready        = (state == State::Run) && !chunk_pending
        && (cpl_match0 || cpl_match1);
    assign fb_req_valid     = (state == State::Run) && chunk_pending && (fb_outstanding <: 8);
    assign fb_req_addr      = write_vram;
    assign fb_req_wdata     = shifted_words;
    assign fb_req_wstrb     = if write_word_count == 4'd8 ? 32'hffff_ffff
        : if write_word_count == 4'd2 ? 32'h0000_00ff : 32'h0000_000f;
    assign fb_rsp_ready     = ((state == State::Run) || (state == State::Fail))
        && (fb_outstanding != 0);
    let fb_request_accept: logic = fb_req_valid && fb_req_ready;
    let fb_response_accept: logic = fb_rsp_valid && fb_rsp_ready;

    always_ff {
        if_reset {
            state              = State::Idle;
            issue_host         = 0;
            issue_vram         = 0;
            length_bytes       = 0;
            issue_remaining_dw = 0;
            next_tag           = 0;
            slot_valid         = 0;
            slot_tag           = '{default: '0};
            slot_host          = '{default: '0};
            slot_vram          = '{default: '0};
            slot_length        = '{default: '0};
            slot_done          = '{default: '0};
            chunk_pending      = 0;
            chunk_slot         = 0;
            chunk_words        = 0;
            chunk_left         = 0;
            chunk_total        = 0;
            chunk_index        = 0;
            write_vram         = 0;
            fb_outstanding     = 0;
            timeout_counter    = 0;
            done               = 0;
            error              = 0;
        } else {
            done = 0;
            if fb_request_accept && !fb_response_accept {
                fb_outstanding = fb_outstanding + 4'd1;
            } else if fb_response_accept && !fb_request_accept {
                fb_outstanding = fb_outstanding - 4'd1;
            }
            if state == State::Idle || progress {
                timeout_counter = 0;
            } else if (state == State::Run) && (timeout_counter >= TIMEOUT_CYCLES - 1) {
                error = 1;
                state = State::Fail;
            } else if state == State::Run {
                timeout_counter = timeout_counter + 1;
            }

            case state {
                State::Idle: if cmd_valid {
                    issue_host         = cmd_host_address;
                    issue_vram         = cmd_vram_address;
                    length_bytes       = cmd_length_bytes;
                    issue_remaining_dw = cmd_length_bytes[31:2];
                    slot_valid         = 0;
                    chunk_pending      = 0;
                    fb_outstanding     = 0;
                    error              = 0;
                    state              = State::Validate;
                }
                State::Validate: {
                    if command_ok {
                        state = State::Run;
                    } else {
                        error = 1;
                        state = State::Fail;
                    }
                }
                State::Run: {
                    if mrd_valid && mrd_ready {
                        slot_valid[issue_slot]  = 1;
                        slot_tag[issue_slot]    = next_tag;
                        slot_host[issue_slot]   = issue_host;
                        slot_vram[issue_slot]   = issue_vram;
                        slot_length[issue_slot] = next_request_dw;
                        slot_done[issue_slot]   = 0;
                        issue_host              = issue_host + ((next_request_dw as 64) << 2);
                        issue_vram              = issue_vram + ((next_request_dw as 32) << 2);
                        issue_remaining_dw      = issue_remaining_dw - (next_request_dw as 30);
                        next_tag                = next_tag + 8'd1;
                    }

                    if cpl_valid && cpl_ready {
                        if cpl_error || !cpl_has_data || (cpl_length_dw == 0)
                            || ((cpl_length_dw as 6) >: cpl_remaining)
                            || (cpl_lower_address != cpl_expected_lower) {
                            error = 1;
                            state = State::Fail;
                        } else {
                            chunk_pending = 1;
                            chunk_slot    = cpl_slot;
                            chunk_words   = cpl_data;
                            chunk_left    = cpl_length_dw;
                            chunk_total   = cpl_length_dw;
                            chunk_index   = 0;
                            write_vram    = if cpl_slot ? cpl_vram1 : cpl_vram0;
                        }
                    }

                    if fb_request_accept {
                        write_vram  = write_vram + ((write_word_count as 32) << 2);
                        chunk_left  = chunk_left - write_word_count;
                        chunk_index = chunk_index + write_word_count;
                        if chunk_left <= write_word_count {
                            chunk_pending = 0;
                            if (slot_done[chunk_slot] + (chunk_total as 5)) >= slot_length[chunk_slot] {
                                slot_valid[chunk_slot] = 0;
                            } else {
                                slot_done[chunk_slot] = slot_done[chunk_slot] + (chunk_total as 5);
                            }
                        }
                    }
                    if fb_response_accept {
                        if fb_rsp_error {
                            error = 1;
                            state = State::Fail;
                        }
                    }

                    if (issue_remaining_dw == 0) && (slot_valid == 0)
                        && !chunk_pending && (fb_outstanding == 0) {
                        state = State::Finish;
                    }
                }
                State::Finish: {
                    error = 0;
                    done  = 1;
                    state = State::Idle;
                }
                State::Fail: {
                    slot_valid    = 0;
                    chunk_pending = 0;
                    if fb_outstanding == 0 {
                        done  = 1;
                        state = State::Idle;
                    }
                }
                default: {
                    error = 1;
                    state = State::Fail;
                }
            }
        }
    }
}
