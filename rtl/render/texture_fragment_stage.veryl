/// Join raster metadata to a nearest-neighbour texture lookup.
///
/// Exactly one fragment is in flight.  Coordinates and depth remain paired
/// with the sampled color while either DDR or the downstream writer stalls.
module texture_fragment_stage (
    clk             : input  clock            ,
    rst_n           : input  reset            ,
    clear           : input  logic            ,
    texture_base    : input  logic<32>        ,
    texture_stride  : input  logic<32>        ,
    texture_width   : input  logic<16>        ,
    texture_height  : input  logic<16>        ,
    input_valid     : input  logic            ,
    input_ready     : output logic            ,
    input_x         : input  logic<16>        ,
    input_y         : input  logic<16>        ,
    input_depth     : input  logic<16>        ,
    input_u         : input  signed logic<24> ,
    input_v         : input  signed logic<24> ,
    output_valid    : output logic            ,
    output_ready    : input  logic            ,
    output_x        : output logic<16>        ,
    output_y        : output logic<16>        ,
    output_depth    : output logic<16>        ,
    output_color    : output logic<32>        ,
    busy            : output logic            ,
    fault           : output logic            ,
    mem_valid       : output logic            ,
    mem_ready       : input  logic            ,
    mem_write       : output logic            ,
    mem_addr        : output logic<24>        ,
    mem_wdata       : output logic<256>       ,
    mem_wstrb       : output logic<32>        ,
    mem_rsp_valid   : input  logic            ,
    mem_rsp_ready   : output logic            ,
    mem_rsp_data    : input  logic<256>       ,
    mem_rsp_error   : input  logic            ,
) {
    var metadata_valid: logic;
    var pending_x: logic<16>;
    var pending_y: logic<16>;
    var pending_depth: logic<16>;
    var sampler_ready: logic;
    var sampler_color_valid: logic;
    var sampler_color_ready: logic;
    var sampler_color: logic<32>;
    var sampler_busy: logic;
    var sampler_fault: logic;

    let accept: logic = input_valid && input_ready;

    inst sampler: texture_sampler (
        clk,
        rst_n,
        clear,
        texture_base,
        texture_stride,
        texture_width,
        texture_height,
        sample_valid : input_valid && !metadata_valid,
        sample_ready : sampler_ready,
        sample_u     : input_u,
        sample_v     : input_v,
        color_valid  : sampler_color_valid,
        color_ready  : sampler_color_ready,
        color        : sampler_color,
        busy         : sampler_busy,
        fault        : sampler_fault,
        mem_valid,
        mem_ready,
        mem_write,
        mem_addr,
        mem_wdata,
        mem_wstrb,
        mem_rsp_valid,
        mem_rsp_ready,
        mem_rsp_data,
        mem_rsp_error,
    );

    assign input_ready = sampler_ready && !metadata_valid;
    assign output_valid = sampler_color_valid && metadata_valid;
    assign sampler_color_ready = output_ready && metadata_valid;
    assign output_x = pending_x;
    assign output_y = pending_y;
    assign output_depth = pending_depth;
    assign output_color = sampler_color;
    assign busy = metadata_valid || sampler_busy;
    assign fault = sampler_fault;

    always_ff {
        if_reset {
            metadata_valid = 0;
            pending_x = 0;
            pending_y = 0;
            pending_depth = 0;
        } else {
            if accept {
                metadata_valid = 1;
                pending_x = input_x;
                pending_y = input_y;
                pending_depth = input_depth;
            }
            if output_valid && output_ready {
                metadata_valid = 0;
            }
            if clear {
                metadata_valid = 0;
            }
        }
    }
}
