/// Dispatch ordered queue entries to the render-engine command mailboxes.
module render_queue_dispatcher (
    clk                  : input  clock     ,
    rst_n                : input  reset     ,
    dispatch_valid       : input  logic     ,
    dispatch_ready       : output logic     ,
    dispatch_command     : input  logic<402>,
    legacy_fill_start    : input  logic     ,
    legacy_blit_start    : input  logic     ,
    legacy_triangle_start: input  logic     ,
    fill_ready           : input  logic     ,
    fill_done            : input  logic     ,
    fill_error           : input  logic     ,
    blit_ready           : input  logic     ,
    blit_done            : input  logic     ,
    blit_error           : input  logic     ,
    triangle_ready       : input  logic     ,
    triangle_done        : input  logic     ,
    triangle_error       : input  logic     ,
    fill_start           : output logic     ,
    fill_command         : output logic<128>,
    blit_start           : output logic     ,
    blit_command         : output logic<160>,
    triangle_start       : output logic     ,
    triangle_command     : output logic<368>,
    completion_valid     : output logic     ,
    completion_error     : output logic     ,
) {
    const OPCODE_FILL: logic<2> = 2'd1;
    const OPCODE_BLIT: logic<2> = 2'd2;
    const OPCODE_TRIANGLE: logic<2> = 2'd3;
    const STATE_FILL: logic<3> = 3'd1;
    const STATE_BLIT: logic<3> = 3'd2;
    const STATE_TRIANGLE: logic<3> = 3'd3;
    const STATE_INVALID: logic<3> = 3'd4;
    var running_opcode: logic<3>;
    let opcode: logic<2> = dispatch_command[1:0];
    let fill_admit: logic = dispatch_valid && (opcode == OPCODE_FILL) && fill_ready && !legacy_fill_start;
    let blit_admit: logic = dispatch_valid && (opcode == OPCODE_BLIT) && blit_ready && !legacy_blit_start;
    let triangle_admit: logic = dispatch_valid && (opcode == OPCODE_TRIANGLE)
        && triangle_ready && !legacy_triangle_start;
    let invalid_admit: logic = dispatch_valid && (opcode != OPCODE_FILL)
        && (opcode != OPCODE_BLIT) && (opcode != OPCODE_TRIANGLE);

    assign dispatch_ready   = (running_opcode == 0)
        && (fill_admit || blit_admit || triangle_admit || invalid_admit);
    assign fill_start       = (running_opcode == 0) && fill_admit;
    assign blit_start       = (running_opcode == 0) && blit_admit;
    assign triangle_start   = (running_opcode == 0) && triangle_admit;
    assign fill_command     = dispatch_command[161:34];
    assign blit_command     = dispatch_command[193:34];
    assign triangle_command = dispatch_command[401:34];
    assign completion_valid = ((running_opcode == STATE_FILL) && fill_done)
        || ((running_opcode == STATE_BLIT) && blit_done)
        || ((running_opcode == STATE_TRIANGLE) && triangle_done)
        || (running_opcode == STATE_INVALID);
    assign completion_error = if running_opcode == STATE_FILL ? fill_error
        : if running_opcode == STATE_BLIT ? blit_error
        : if running_opcode == STATE_TRIANGLE ? triangle_error
        : if running_opcode == STATE_INVALID ? 1'b1 : 1'b0;

    always_ff {
        if_reset {
            running_opcode = 0;
        } else {
            if dispatch_valid && dispatch_ready {
                running_opcode = if invalid_admit ? STATE_INVALID : {1'b0, opcode};
            }
            if completion_valid {
                running_opcode = 0;
            }
        }
    }
}
