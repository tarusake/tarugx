/// CTA-861 1920x1080p60 timing: 2200x1125 total, positive sync.
/// A 148.4375 MHz implementation clock gives 59.974747 Hz.
module video_timing_1080p (
    clk        : input  clock    ,
    rst_n      : input  reset    ,
    x          : output logic<12>,
    y          : output logic<11>,
    de         : output logic    ,
    hsync      : output logic    ,
    vsync      : output logic    ,
    frame_start: output logic    ,
) {
    always_ff {
        if_reset {
            x = 0;
            y = 0;
        } else if x == 12'd2199 {
            x = 0;
            if y == 11'd1124 {
                y = 0;
            } else {
                y = y + 11'd1;
            }
        } else {
            x = x + 12'd1;
        }
    }
    assign de          = (x <: 12'd1920) && (y <: 11'd1080);
    assign hsync       = (x >= 12'd2008) && (x <: 12'd2052);
    assign vsync       = (y >= 11'd1084) && (y <: 11'd1089);
    assign frame_start = (x == 0) && (y == 0);
}
