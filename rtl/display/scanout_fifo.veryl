/// FWFT FIFO: error bit, frame beat index, eight XRGB8888 pixels.
/// Both domains must reset together; the caller must synchronize reset release.
module scanout_fifo #(
    param DEPTH      : u32 = 512,
    param INDEX_WIDTH: u32 = 16 ,
) (
    src_clk     : input  'src clock     ,
    src_rst_n   : input  'src reset     ,
    src_valid   : input  'src logic     ,
    src_ready   : output 'src logic     ,
    src_buffered: output 'src logic     , // At least half the FIFO, conservative UI estimate.
    src_data    : input  'src logic<257 + INDEX_WIDTH>,
    dst_clk     : input  'dst clock     ,
    dst_rst_n   : input  'dst reset     ,
    dst_valid   : output 'dst logic     ,
    dst_ready   : input  'dst logic     ,
    dst_data    : output 'dst logic<257 + INDEX_WIDTH>,
) {
    var full : 'src logic;
    var empty: 'dst logic;
    var raw_data : 'dst logic<257 + INDEX_WIDTH>;
    let raw_valid: 'dst logic = !empty;
    // Register the dual-clock RAM output before it fans into pixel selection,
    // fault capture and the TMDS encoder. This one-entry elastic stage keeps
    // ready/valid semantics while separating RAM access from the pixel path.
    let load_output: 'dst logic = !dst_valid || dst_ready;
    assign src_ready = !full;
    inst fifo: $std::async_fifo::<$std::synchronizer_basic> #(
        WIDTH    : 257 + INDEX_WIDTH,
        DEPTH               ,
        THRESHOLD: DEPTH / 2,
    ) (
        is_clk        : src_clk               ,
        is_rst        : src_rst_n             ,
        os_almost_full: src_buffered          ,
        os_full       : full                  ,
        is_push       : src_valid && src_ready,
        is_data       : src_data              ,
        id_clk        : dst_clk               ,
        id_rst        : dst_rst_n             ,
        od_empty      : empty                 ,
        id_pop        : raw_valid && load_output,
        od_data       : raw_data                 ,
    );
    always_ff (dst_clk, dst_rst_n) {
        if_reset {
            dst_valid = 0;
            dst_data  = 0;
        } else if load_output {
            dst_valid = raw_valid;
            if raw_valid {
                dst_data = raw_data;
            }
        }
    }
}
