// SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1
/// Fixed-mode pixel consumer. After a lost beat, black the rest of the frame
/// and discard queued beats until index zero for a later frame boundary.
module framebuffer_display #(
    param VIDEO_1080P : bbool = false,
    param WIDTH       : u32 = if VIDEO_1080P ? 1920 : 640,
    param HEIGHT      : u32 = if VIDEO_1080P ? 1080 : 480,
    param INDEX_WIDTH : u32 = if VIDEO_1080P ? 18 : 16,
    param PIXELS_PER_BEAT: u32 = if VIDEO_1080P ? 16 : 8,
    param X_WIDTH     : u32 = if VIDEO_1080P ? 12 : 10,
    param Y_WIDTH     : u32 = if VIDEO_1080P ? 11 : 10,
    param BEATS_PER_ROW: u32 = WIDTH / PIXELS_PER_BEAT,
    param LAST_X      : bit<X_WIDTH> = (WIDTH - 1) as X_WIDTH,
    param LAST_Y      : bit<Y_WIDTH> = (HEIGHT - 1) as Y_WIDTH,
) (
    clk           : input  clock     ,
    rst_n         : input  reset     ,
    settings      : input  logic<26> ,
    in_valid      : input  logic     ,
    in_ready      : output logic     ,
    in_data       : input  logic<257 + INDEX_WIDTH>,
    de            : output logic     ,
    hsync         : output logic     ,
    vsync         : output logic     ,
    rgb           : output logic<24> ,
    underflow     : output logic     ,
    vblank_toggle : output logic     ,
    display_active: output logic     ,
    fault_snapshot: output logic<64> ,
) {
    var x          : logic<X_WIDTH>;
    var y          : logic<Y_WIDTH>;
    var frame_start: logic    ;
    var active     : logic<26>;
    var running    : logic    ;
    var armed      : logic    ;
    var timing_de         : logic    ;
    var timing_hsync      : logic    ;
    var timing_vsync      : logic    ;
    var stage_de          : logic    ;
    var stage_hsync       : logic    ;
    var stage_vsync       : logic    ;
    var stage_pixel       : logic<24>;
    var stage_enable      : logic    ;
    var stage_solid       : logic    ;
    var stage_color       : logic<24>;
    var stage_pixel_valid : logic    ;
    var fault_pending     : logic    ;
    var fault_check_pending: logic   ;
    var fault_low_bad     : logic    ;
    var fault_high_bad    : logic    ;
    var fault_context     : logic<64>;
    if VIDEO_1080P :g_timing_1080p {
        inst timing: video_timing_1080p (
            clk, rst_n, x, y,
            de: timing_de, hsync: timing_hsync, vsync: timing_vsync,
            frame_start,
        );
    } else :g_timing_480p {
        inst timing: video_timing (
            clk, rst_n, x, y,
            de: timing_de, hsync: timing_hsync, vsync: timing_vsync,
            frame_start,
        );
    }
    let current_settings: logic<26> = if frame_start ? settings : active;
    assign display_active = current_settings[24];
    let expected    : logic<INDEX_WIDTH> = (y as INDEX_WIDTH) * (BEATS_PER_ROW as INDEX_WIDTH)
        + (if VIDEO_1080P ? ((x as INDEX_WIDTH) >> 4) : ((x as INDEX_WIDTH) >> 3));
    let consuming   : logic     = if frame_start
        ? (in_valid && !in_data[256 + INDEX_WIDTH] && (in_data[255 + INDEX_WIDTH:256] == 0))
        : running;
    let pixel_8888  : logic<32> = in_data[(x[2:0] as 9) * 9'd32+:32];
    let pixel_565   : logic<16> = in_data[(x[3:0] as 9) * 9'd16+:16];
    let expanded_565: logic<24> = {
        pixel_565[15:11], pixel_565[15:13],
        pixel_565[10:5], pixel_565[10:9],
        pixel_565[4:0], pixel_565[4:2]
    };
    let pixel       : logic<24> = if VIDEO_1080P ? expanded_565 : pixel_8888[23:0];
    // A FIFO beat covers eight XRGB8888 or sixteen RGB565 pixels. Its index is checked as two short
    // comparisons at pixel zero, then combined on the following cycle.
    always_comb {
        de    = stage_de;
        hsync = stage_hsync;
        vsync = stage_vsync;
        rgb   = 0;
        if stage_de && stage_enable {
            if stage_solid {
                rgb = stage_color;
            } else if stage_pixel_valid {
                rgb = stage_pixel;
            }
        }
    }
    always_ff {
        if_reset {
            in_ready       = 0;
            stage_de         = 0;
            stage_hsync      = 0;
            stage_vsync      = 0;
            stage_pixel      = 0;
            stage_enable     = 0;
            stage_solid      = 0;
            stage_color      = 0;
            stage_pixel_valid = 0;
            active         = 0;
            running        = 0;
            armed          = 0;
            underflow      = 0;
            vblank_toggle  = 0;
            fault_snapshot = 0;
            fault_pending  = 0;
            fault_check_pending = 0;
            fault_low_bad  = 0;
            fault_high_bad = 0;
            fault_context  = 0;
        } else {
            // Register timing, the dynamic 256-to-32-bit pixel selection and
            // its validity separately. The final RGB choice then has only
            // registered inputs on the path into the vendor TMDS encoder.
            stage_de          = timing_de;
            stage_hsync       = timing_hsync;
            stage_vsync       = timing_vsync;
            stage_pixel       = pixel;
            stage_enable      = current_settings[24];
            stage_solid       = current_settings[25];
            stage_color       = current_settings[23:0];
            // Once a beat has passed the boundary check, all eight pixels
            // share that result. A mismatch is recorded by fault_pending and
            // stops running before the later pop point; do not fan the wide
            // index comparator out into the per-pixel video path as well.
            stage_pixel_valid = consuming;
            // Split the 16/18-bit equality into two registered comparisons.
            // The extra fault pipeline cycle still stops running several
            // pixels before the FIFO pop request at pixel six.
            fault_pending = fault_check_pending && (fault_low_bad || fault_high_bad);
            fault_check_pending = 0;
            if timing_de && (if VIDEO_1080P ? (x[3:0] == 0) : (x[2:0] == 0)) {
                fault_check_pending = current_settings[24]
                    && !current_settings[25] && armed;
                fault_low_bad = !consuming || !in_valid || in_data[256 + INDEX_WIDTH]
                    || (in_data[264:256] != expected[8:0]);
                fault_high_bad = in_data[255 + INDEX_WIDTH:265]
                    != expected[INDEX_WIDTH - 1:9];
                if VIDEO_1080P {
                    fault_context = ({
                        x, y, expected, in_data[255 + INDEX_WIDTH:256], settings[24], settings[25],
                        armed, consuming, in_valid
                    } as 64);
                } else {
                    fault_context = ({
                        x, y, expected, in_data[255 + INDEX_WIDTH:256], 4'b0, settings[24], settings[25],
                        current_settings[24], current_settings[25], armed, consuming, in_valid,
                        in_data[256 + INDEX_WIDTH]
                    } as 64);
                }
            }
            if fault_pending {
                running = 0;
                if !underflow {
                    fault_snapshot = fault_context;
                }
                underflow = 1;
            }
            // Register FIFO backpressure one pixel ahead. The previous
            // combinational x/index/error decision drove the clock enables of
            // every wide output-register bit and could not close at 148 MHz.
            // A discard pulse is followed by a bubble so a newly exposed
            // index-zero beat is inspected before it can be removed.
            if in_ready {
                in_ready = 0;
            } else if !consuming {
                in_ready = in_valid
                    && ((in_data[255 + INDEX_WIDTH:256] != 0) || in_data[256 + INDEX_WIDTH]);
            } else {
                // A bad beat is diagnosed at pixel zero and clears running
                // before this one-cycle-early pop request at pixel six.
                in_ready = timing_de && (if VIDEO_1080P ? (x[3:0] == 14) : (x[2:0] == 6));
            }
            if frame_start {
                vblank_toggle = !vblank_toggle;
            }
            // Enabling scanout starts an asynchronous DDR prefill. Wait for
            // index zero at a frame boundary before diagnosing starvation.
            if !current_settings[24] || current_settings[25] {
                armed = 0;
            } else if frame_start && consuming {
                armed = 1;
            }
            if frame_start {
                active  = settings;
                running = consuming;
            }
            if (x == LAST_X) && (y == LAST_Y) {
                running = 0;
            }
        }
    }
}
