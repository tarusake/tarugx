/// 720p60 physical-link test pattern, independent from DDR scanout.
module video_test_pattern_720p (
    clk          : input  clock    ,
    rst_n        : input  reset    ,
    de           : output logic    ,
    hsync        : output logic    ,
    vsync        : output logic    ,
    rgb          : output logic<24>,
    vblank_toggle: output logic    ,
) {
    var x          : logic<11>;
    var y          : logic<10>;
    var frame_start: logic    ;
    inst timing: video_timing_720p (
        clk, rst_n, x, y, de, hsync, vsync, frame_start,
    );
    always_comb {
        rgb = 0;
        if de {
            if (x <: 8) || (x >= 1272) || (y <: 8) || (y >= 712) {
                rgb = 24'hffffff;
            } else if x <: 160 {
                rgb = 24'hff0000;
            } else if x <: 320 {
                rgb = 24'hffff00;
            } else if x <: 480 {
                rgb = 24'h00ff00;
            } else if x <: 640 {
                rgb = 24'h00ffff;
            } else if x <: 800 {
                rgb = 24'h0000ff;
            } else if x <: 960 {
                rgb = 24'hff00ff;
            } else if x <: 1120 {
                rgb = 24'h808080;
            } else {
                rgb = 24'h202020;
            }
        }
    }
    always_ff {
        if_reset {
            vblank_toggle = 0;
        } else if frame_start {
            vblank_toggle = !vblank_toggle;
        }
    }
}
