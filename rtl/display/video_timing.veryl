/// 640x480, 800x525 total, negative sync. 25.1875 MHz gives 59.970238 Hz.
module video_timing (
    clk        : input  clock    ,
    rst_n      : input  reset    ,
    x          : output logic<10>,
    y          : output logic<10>,
    de         : output logic    ,
    hsync      : output logic    ,
    vsync      : output logic    ,
    frame_start: output logic    ,
) {
    always_ff {
        if_reset {
            x = 0;
            y = 0;
        } else if x == 10'd799 {
            x = 0;
            if y == 10'd524 {
                y = 0;
            } else {
                y = y + 10'd1;
            }
        } else {
            x = x + 10'd1;
        }
    }
    assign de          = (x <: 10'd640) && (y <: 10'd480);
    assign hsync       = !((x >= 10'd656) && (x <: 10'd752));
    assign vsync       = !((y >= 10'd490) && (y <: 10'd492));
    assign frame_start = (x == 0) && (y == 0);
}
