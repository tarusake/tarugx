/// Single-outstanding-transaction BAR0 bridge using normalized PCIe DWORDs.
///
/// This module supplies the ordering point between posted writes and reads: it
/// accepts requests in order and will not accept another request while a read
/// Completion is pending. Gowin lane packing is intentionally outside it.
module bar0_tlp_bridge (
    clk            : input  clock    ,
    rst            : input  reset    ,
    completer_id   : input  logic<16>,
    rx_valid       : input  logic    ,
    rx_ready       : output logic    ,
    rx_bar_decode  : input  logic<6> ,
    rx_header_dw0  : input  logic<32>,
    rx_header_dw1  : input  logic<32>,
    rx_header_dw2  : input  logic<32>,
    rx_header_dw3  : input  logic<32>,
    rx_payload_dw0 : input  logic<32>,
    tx_valid       : output logic    ,
    tx_ready       : input  logic    ,
    tx_header_dw0  : output logic<32>,
    tx_header_dw1  : output logic<32>,
    tx_header_dw2  : output logic<32>,
    tx_payload_dw0 : output logic<32>,
    unsupported    : output logic    ,
    malformed      : output logic    ,
    display_ctrl   : output logic<32>,
    display_color  : output logic<32>,
    display_mode   : output logic<32>,
    fb_base        : output logic<32>,
    fb_stride      : output logic<32>,
    fb_commit_pulse: output logic    ,
) {
    var decoded_valid : logic    ;
    var decoded_write : logic    ;
    var decoded_addr  : logic<16>;
    var decoded_wdata : logic<32>;
    var decoded_be    : logic<4> ;
    var decoded_req_id: logic<16>;
    var decoded_tag   : logic<8> ;
    var ur_required   : logic    ;

    inst decoder: tlp_request_decoder (
        request_valid: rx_valid      ,
        bar_decode   : rx_bar_decode ,
        header_dw0   : rx_header_dw0 ,
        header_dw1   : rx_header_dw1 ,
        header_dw2   : rx_header_dw2 ,
        header_dw3   : rx_header_dw3 ,
        payload_dw0  : rx_payload_dw0,
        decoded_valid                ,
        decoded_write                ,
        decoded_addr                 ,
        decoded_wdata                ,
        decoded_be                   ,
        requester_id : decoded_req_id,
        request_tag  : decoded_tag   ,
        unsupported                  ,
        ur_required                  ,
        malformed                    ,
    );

    var reg_ready     : logic    ;
    var reg_rsp_valid : logic    ;
    var reg_rsp_data  : logic<32>;
    var reg_rsp_error : logic    ;
    let request_accept: logic     = rx_valid && rx_ready;
    let accept        : logic     = request_accept && decoded_valid;
    let ur_accept     : logic     = request_accept && unsupported && ur_required;

    inst registers: gpu_registers (
        clk                           ,
        rst                           ,
        req_valid      : accept       ,
        req_write      : decoded_write,
        req_addr       : decoded_addr ,
        req_wdata      : decoded_wdata,
        req_wstrb      : decoded_be   ,
        req_ready      : reg_ready    ,
        rsp_valid      : reg_rsp_valid,
        rsp_rdata      : reg_rsp_data ,
        rsp_error      : reg_rsp_error,
        display_ctrl                  ,
        display_color                 ,
        display_mode                  ,
        fb_base                       ,
        fb_stride                     ,
        fb_commit_pulse               ,
    );

    var completion_pending: logic    ;
    var saved_req_id      : logic<16>;
    var saved_tag         : logic<8> ;
    var saved_addr        : logic<16>;
    var saved_be          : logic<4> ;
    var saved_data        : logic<32>;
    var saved_status      : logic<3> ;
    var saved_with_data   : logic    ;

    assign rx_ready = !completion_pending;

    always_ff {
        if_reset {
            completion_pending = 1'b0;
            saved_req_id       = 16'b0;
            saved_tag          = 8'b0;
            saved_addr         = 16'b0;
            saved_be           = 4'b0;
            saved_data         = 32'b0;
            saved_status       = 3'b000;
            saved_with_data    = 1'b0;
        } else {
            if accept && !decoded_write {
                completion_pending = 1'b1;
                saved_req_id       = decoded_req_id;
                saved_tag          = decoded_tag;
                saved_addr         = decoded_addr;
                saved_be           = decoded_be;
                saved_data         = reg_rsp_data;
                saved_status       = 3'b000;
                saved_with_data    = 1'b1;
            } else if ur_accept {
                completion_pending = 1'b1;
                saved_req_id       = decoded_req_id;
                saved_tag          = decoded_tag;
                saved_addr         = decoded_addr;
                saved_be           = 4'b0;
                saved_data         = 32'b0;
                saved_status       = 3'b001;
                saved_with_data    = 1'b0;
            } else if tx_valid && tx_ready {
                completion_pending = 1'b0;
            }
        }
    }

    inst completion: tlp_completion_builder (
        completion_valid : completion_pending,
        completion_status: saved_status      ,
        with_data        : saved_with_data   ,
        completer_id                         ,
        requester_id     : saved_req_id      ,
        request_tag      : saved_tag         ,
        request_addr     : saved_addr        ,
        request_be       : saved_be          ,
        read_data        : saved_data        ,
        tx_valid                             ,
        header_dw0       : tx_header_dw0     ,
        header_dw1       : tx_header_dw1     ,
        header_dw2       : tx_header_dw2     ,
        payload_dw0      : tx_payload_dw0    ,
    );
}
