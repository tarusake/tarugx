// SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1
/// Normalize one single-beat Gowin 256-bit receive transfer into PCIe DWORDs.
///
/// Hardware capture on 2026-10-31 confirms DW0 at [255:224], with a
/// three-DWORD Memory Read using valid=0xe0. Valid[n] qualifies lane n.
module tlp_rx_decoder (
    rx_sop       : input  logic     ,
    rx_eop       : input  logic     ,
    rx_valid     : input  logic<8>  ,
    rx_data      : input  logic<256>,
    rx_bar_decode: input  logic<6>  ,
    rx_error     : input  logic<8>  ,
    request_ready: input  logic     ,
    rx_wait      : output logic     ,
    request_valid: output logic     ,
    request_bar  : output logic<6>  ,
    header_dw0   : output logic<32> ,
    header_dw1   : output logic<32> ,
    header_dw2   : output logic<32> ,
    header_dw3   : output logic<32> ,
    payload_dw0  : output logic<32> ,
    framing_error: output logic     ,
) {
    let transfer_present: logic = |rx_valid;

    assign request_valid = transfer_present && rx_sop && rx_eop && (rx_valid[7:5] == 3'b111) && !(|rx_error);
    assign rx_wait       = request_valid && !request_ready;
    assign request_bar   = rx_bar_decode;
    assign header_dw0    = rx_data[255:224];
    assign header_dw1    = rx_data[223:192];
    assign header_dw2    = rx_data[191:160];
    assign header_dw3    = rx_data[159:128];
    assign payload_dw0   = {rx_data[135:128], rx_data[143:136], rx_data[151:144], rx_data[159:152]};
    assign framing_error = transfer_present && (!rx_sop || !rx_eop || (rx_valid[7:5] != 3'b111) || (|rx_error));
}
