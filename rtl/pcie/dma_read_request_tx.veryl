/// Pack one 64-bit-address PCIe Memory Read Request into a Gowin TX beat.
/// Requests are capped at 128 bytes and must not cross a 4 KiB boundary.
module dma_read_request_tx (
    request_valid: input  logic     ,
    requester_id : input  logic<16> ,
    request_tag  : input  logic<8>  ,
    host_address : input  logic<64> ,
    length_dw    : input  logic<6>  ,
    tx_wait      : input  logic     ,
    request_ready: output logic     ,
    request_error: output logic     ,
    tx_sop       : output logic     ,
    tx_eop       : output logic     ,
    tx_valid     : output logic<8>  ,
    tx_data      : output logic<256>,
) {
    let request_bytes: logic<9> = (length_dw as 9) << 2;
    let parameters_ok: logic = (host_address[1:0] == 0) && (length_dw != 0)
        && (length_dw <= 6'd32)
        && (({1'b0, host_address[11:0]} + (request_bytes as 13)) <= 13'd4096);
    let first_be     : logic<4> = 4'hf;
    let last_be      : logic<4> = if length_dw == 1 ? 4'h0 : 4'hf;
    let header_dw0   : logic<32> = 32'h2000_0000 | (length_dw as 32);
    let header_dw1   : logic<32> = {requester_id, request_tag, last_be, first_be};
    let header_dw2   : logic<32> = host_address[63:32];
    let header_dw3   : logic<32> = {host_address[31:2], 2'b0};

    assign request_ready = !tx_wait && parameters_ok;
    assign request_error = request_valid && !parameters_ok;
    assign tx_sop        = request_valid && parameters_ok;
    assign tx_eop        = request_valid && parameters_ok;
    assign tx_valid      = if request_valid && parameters_ok ? 8'hf0 : 8'b0;
    assign tx_data       = {header_dw0, header_dw1, header_dw2, header_dw3, 128'b0};
}
