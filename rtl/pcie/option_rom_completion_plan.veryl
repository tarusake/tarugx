// SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1
/// Normalized MRd32/MRd64 -> <=128-byte Completion descriptors.
/// Only a verified configuration adapter may assert rom_enabled/base.
/// Descriptor acceptance means its entire payload has been captured downstream.
/// No vendor RX/TX framing or ROM configuration discovery is performed here.
module option_rom_completion_plan (
    clk           : input  clock    ,
    rst_n         : input  reset    ,
    req_valid     : input  logic    ,
    req_ready     : output logic    ,
    h0            : input  logic<32>,
    h1            : input  logic<32>,
    h2            : input  logic<32>,
    h3            : input  logic<32>,
    rom_enabled   : input  logic    ,
    rom_base      : input  logic<16>,
    cpl_valid     : output logic    ,
    cpl_ready     : input  logic    ,
    cpl_status    : output logic<3> ,
    cpl_addr      : output logic<16>,
    cpl_length    : output logic<6> ,
    cpl_byte_count: output logic<12>,
    cpl_lower_addr: output logic<7> ,
    cpl_requester : output logic<16>,
    cpl_tag       : output logic<8> ,
    cpl_tc        : output logic<3> ,
    cpl_attr      : output logic<2> ,
    malformed     : output logic    ,
    unsupported   : output logic    ,
) {
    function first (
        be: input logic<4>,
    ) -> logic<2> {
        if be[0] {
            return 0;
        } else if be[1] {
            return 1;
        } else if be[2] {
            return 2;
        } else if be[3] {
            return 3;
        } else {
            return 0;
        }
    }
    function last (
        be: input logic<4>,
    ) -> logic<2> {
        if be[3] {
            return 3;
        } else if be[2] {
            return 2;
        } else if be[1] {
            return 1;
        } else {
            return 0;
        }
    }
    var busy          : logic    ;
    var remaining     : logic<11>;
    var byte_count    : logic<13>;
    var offset        : logic<2> ;
    let fmt           : logic<3>  = h0[31:29];
    let read_request  : logic     = (h0[28:24] == 0) && ((fmt == 0) || (fmt == 1));
    let address       : logic<32> = if fmt[0] ? h3 : h2;
    let length        : logic<11> = if h0[9:0] == 0 ? 11'd1024 : {1'b0, h0[9:0]};
    let fbe           : logic<4>  = h1[3:0];
    let lbe           : logic<4>  = h1[7:4];
    let leading       : logic<2>  = first(fbe);
    let trailing      : logic<2>  = if length == 1 ? 2'd3 - last(fbe) : 2'd3 - last(lbe);
    let full_bytes    : logic<13> = (length as 13) << 2;
    let page_end      : logic<13> = (address[11:0] as 13) + full_bytes;
    let sparse_allowed: logic     = (length == 1) || ((length == 2) && !address[2]);
    let contiguous    : logic     = ((fbe == 4'hf) || (fbe == 4'he) || (fbe == 4'hc) || (fbe == 4'h8))
        && ((lbe == 4'hf) || (lbe == 4'h7) || (lbe == 4'h3) || (lbe == 4'h1));
    let bad_be        : logic     = if length == 1 ?
        lbe != 0
    :
        (fbe == 0) || (lbe == 0) || (!sparse_allowed && !contiguous)
    ;
    let room          : logic<6>  = 6'd32 - (cpl_addr[6:2] as 6);
    let chunk         : logic<6>  = if (remaining <: (room as 11)) ? (remaining as 6) : room;
    assign req_ready      = !busy;
    assign cpl_valid      = busy;
    assign cpl_length     = if cpl_status == 0 ? chunk : 6'b0;
    assign cpl_byte_count = if cpl_status == 0 ? byte_count[11:0] : 12'b0;
    assign cpl_lower_addr = if cpl_status == 0 ? cpl_addr[6:0] + (offset as 7) : 7'b0;

    always_ff {
        if_reset {
            busy          = 0;
            remaining     = 0;
            byte_count    = 0;
            offset        = 0;
            cpl_status    = 0;
            cpl_addr      = 0;
            cpl_requester = 0;
            cpl_tag       = 0;
            cpl_tc        = 0;
            cpl_attr      = 0;
            malformed     = 0;
            unsupported   = 0;
        } else {
            malformed   = 0;
            unsupported = 0;
            if !busy && req_valid {
                if !read_request {
                    // Posted writes and other types never access the ROM.
                    unsupported = 1;
                } else if (address[1:0] != 0) || (page_end >: 13'd4096) || bad_be {
                    malformed = 1;
                } else {
                    cpl_requester = h1[31:16];
                    cpl_tag       = h1[15:8];
                    cpl_tc        = h0[22:20];
                    cpl_attr      = h0[13:12];
                    cpl_addr      = address[15:0];
                    remaining     = length;
                    offset        = leading;
                    byte_count    = full_bytes - (leading as 13) - (trailing as 13);
                    // Zero-length read still receives one DW / Byte Count=4.
                    if (length == 1) && (fbe == 0) {
                        byte_count = 4;
                        offset     = 0;
                    }
                    busy       = 1;
                    cpl_status = 0;
                    // No guessing of a ROM hit, no poisoned/translated requests.
                    if !rom_enabled || (address[31:16] != rom_base) || (fmt[0] && (h2 != 0)) || h0[14] || h0[15]
                        || h0[18] || (h0[11:10] != 0) {
                        cpl_status  = 1;
                        unsupported = 1;
                    }
                }
            } else if busy && cpl_ready {
                if (cpl_status != 0) || (remaining == (chunk as 11)) {
                    busy = 0;
                } else {
                    remaining  = remaining - (chunk as 11);
                    cpl_addr   = cpl_addr + ((chunk as 16) << 2);
                    byte_count = byte_count - ((chunk as 13) << 2) + (offset as 13);
                    offset     = 0;
                }
            }
        }
    }
}
