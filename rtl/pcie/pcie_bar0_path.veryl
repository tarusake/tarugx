/// Complete Phase-1 application path at the Gowin PCIe TLP user boundary.
module pcie_bar0_path (
    clk            : input  clock     ,
    rst            : input  reset     ,
    completer_id   : input  logic<16> ,
    rx_sop         : input  logic     ,
    rx_eop         : input  logic     ,
    rx_valid       : input  logic<8>  ,
    rx_data        : input  logic<256>,
    rx_bar_decode  : input  logic<6>  ,
    rx_error       : input  logic<8>  ,
    rx_wait        : output logic     ,
    rx_masknp      : output logic     ,
    tx_wait        : input  logic     ,
    tx_sop         : output logic     ,
    tx_eop         : output logic     ,
    tx_valid       : output logic<8>  ,
    tx_data        : output logic<256>,
    framing_error  : output logic     ,
    unsupported    : output logic     ,
    malformed      : output logic     ,
    active_buffer  : input  logic     ,
    active_fb_base : input  logic<32> ,
    vblank_toggle  : input  logic     ,
    fill_busy      : input  logic     ,
    fill_done      : input  logic     ,
    fill_error     : input  logic     ,
    blit_busy      : input  logic     ,
    blit_done      : input  logic     ,
    blit_error     : input  logic     ,
    triangle_busy  : input  logic     ,
    triangle_done  : input  logic     ,
    triangle_error : input  logic     ,
    triangle_writes: input  logic<32> ,
    queue_ready    : input  logic     ,
    queue_level    : input  logic<3>  ,
    queue_active   : input  logic     ,
    queue_completed: input  logic<32> ,
    queue_error    : input  logic     ,
    queue_error_fence: input logic<32>,
    display_ctrl   : output logic<32> ,
    display_color  : output logic<32> ,
    display_mode   : output logic<32> ,
    fb_base        : output logic<32> ,
    fb_stride      : output logic<32> ,
    fb_commit_pulse: output logic     ,
    irq_enable     : output logic<2>  ,
    fill_command   : output logic<128>,
    fill_start     : output logic     ,
    blit_command   : output logic<160>,
    blit_start     : output logic     ,
    triangle_command: output logic<368>,
    triangle_start : output logic     ,
    queue_command  : output logic<402>,
    queue_submit   : output logic     ,
    queue_clear_error: output logic   ,
) {
    var request_valid: logic    ;
    var request_ready: logic    ;
    var request_bar  : logic<6> ;
    var header_dw0   : logic<32>;
    var header_dw1   : logic<32>;
    var header_dw2   : logic<32>;
    var header_dw3   : logic<32>;
    var payload_dw0  : logic<32>;
    var payload_dw1  : logic<32>;

    inst rx_adapter: tlp_rx_decoder (
        rx_sop         ,
        rx_eop         ,
        rx_valid       ,
        rx_data        ,
        rx_bar_decode  ,
        rx_error       ,
        request_ready  ,
        rx_wait        ,
        request_valid  ,
        request_bar    ,
        header_dw0     ,
        header_dw1     ,
        header_dw2     ,
        header_dw3     ,
        payload_dw0    ,
        payload_dw1    ,
        framing_error  ,
    );

    var completion_valid  : logic    ;
    var completion_ready  : logic    ;
    var completion_header0: logic<32>;
    var completion_header1: logic<32>;
    var completion_header2: logic<32>;
    var completion_payload: logic<32>;
    var unused_dma_host_address: logic<64>;
    var unused_dma_vram_address: logic<32>;
    var unused_dma_length_bytes: logic<32>;
    var unused_dma_cmd_valid   : logic    ;

    inst bridge: bar0_tlp_bridge (
        clk                                ,
        rst                                ,
        completer_id                       ,
        rx_valid       : request_valid     ,
        rx_ready       : request_ready     ,
        rx_bar_decode  : request_bar       ,
        rx_header_dw0  : header_dw0        ,
        rx_header_dw1  : header_dw1        ,
        rx_header_dw2  : header_dw2        ,
        rx_header_dw3  : header_dw3        ,
        rx_payload_dw0 : payload_dw0       ,
        tx_valid       : completion_valid  ,
        tx_ready       : completion_ready  ,
        tx_header_dw0  : completion_header0,
        tx_header_dw1  : completion_header1,
        tx_header_dw2  : completion_header2,
        tx_payload_dw0 : completion_payload,
        unsupported                        ,
        malformed                          ,
        active_buffer                      ,
        active_fb_base                     ,
        vblank_toggle                      ,
        fill_busy                          ,
        fill_done                          ,
        fill_error                         ,
        blit_busy                          ,
        blit_done                          ,
        blit_error                         ,
        triangle_busy                      ,
        triangle_done                      ,
        triangle_error                     ,
        triangle_writes                    ,
        queue_ready                        ,
        queue_level                        ,
        queue_active                       ,
        queue_completed                    ,
        queue_error                        ,
        queue_error_fence                  ,
        dma_cmd_ready  : 1'b0              ,
        dma_busy       : 1'b1              ,
        dma_done       : 1'b0              ,
        dma_error      : 1'b0              ,
        dma_error_code : 4'b0              ,
        dma_profile    : 192'b0            ,
        display_ctrl                       ,
        display_color                      ,
        display_mode                       ,
        fb_base                            ,
        fb_stride                          ,
        fb_commit_pulse                    ,
        irq_enable                         ,
        fill_command                       ,
        fill_start                         ,
        blit_command                       ,
        blit_start                         ,
        triangle_command                   ,
        triangle_start                     ,
        queue_command                      ,
        queue_submit                       ,
        queue_clear_error                  ,
        dma_host_address: unused_dma_host_address,
        dma_vram_address: unused_dma_vram_address,
        dma_length_bytes: unused_dma_length_bytes,
        dma_cmd_valid   : unused_dma_cmd_valid,
    );

    inst tx_adapter: tlp_tx_completion (
        completion_valid                        ,
        completion_data : completion_header0[30],
        header_dw0      : completion_header0    ,
        header_dw1      : completion_header1    ,
        header_dw2      : completion_header2    ,
        payload_dw0     : completion_payload    ,
        tx_wait                                 ,
        completion_ready                        ,
        tx_sop                                  ,
        tx_eop                                  ,
        tx_valid                                ,
        tx_data                                 ,
    );

    // Block later Non-Posted requests from acceptance through Completion.
    assign rx_masknp = !request_ready || (request_valid && !header_dw0[30] && (header_dw0[28:24] == 5'b00000));
}
