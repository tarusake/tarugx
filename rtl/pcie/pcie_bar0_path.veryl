/// Complete Phase-1 application path at the Gowin PCIe TLP user boundary.
module pcie_bar0_path (
    clk            : input  clock     ,
    rst            : input  reset     ,
    completer_id   : input  logic<16> ,
    rx_sop         : input  logic     ,
    rx_eop         : input  logic     ,
    rx_valid       : input  logic<8>  ,
    rx_data        : input  logic<256>,
    rx_bar_decode  : input  logic<6>  ,
    rx_error       : input  logic<8>  ,
    rx_wait        : output logic     ,
    rx_masknp      : output logic     ,
    tx_wait        : input  logic     ,
    tx_sop         : output logic     ,
    tx_eop         : output logic     ,
    tx_valid       : output logic<8>  ,
    tx_data        : output logic<256>,
    framing_error  : output logic     ,
    unsupported    : output logic     ,
    malformed      : output logic     ,
    display_ctrl   : output logic<32> ,
    display_color  : output logic<32> ,
    display_mode   : output logic<32> ,
    fb_base        : output logic<32> ,
    fb_stride      : output logic<32> ,
    fb_commit_pulse: output logic     ,
) {
    var request_valid: logic    ;
    var request_ready: logic    ;
    var request_bar  : logic<6> ;
    var header_dw0   : logic<32>;
    var header_dw1   : logic<32>;
    var header_dw2   : logic<32>;
    var header_dw3   : logic<32>;
    var payload_dw0  : logic<32>;

    inst rx_adapter: tlp_rx_decoder (
        rx_sop         ,
        rx_eop         ,
        rx_valid       ,
        rx_data        ,
        rx_bar_decode  ,
        rx_error       ,
        request_ready  ,
        rx_wait        ,
        request_valid  ,
        request_bar    ,
        header_dw0     ,
        header_dw1     ,
        header_dw2     ,
        header_dw3     ,
        payload_dw0    ,
        framing_error  ,
    );

    var completion_valid  : logic    ;
    var completion_ready  : logic    ;
    var completion_header0: logic<32>;
    var completion_header1: logic<32>;
    var completion_header2: logic<32>;
    var completion_payload: logic<32>;

    inst bridge: bar0_tlp_bridge (
        clk                                ,
        rst                                ,
        completer_id                       ,
        rx_valid       : request_valid     ,
        rx_ready       : request_ready     ,
        rx_bar_decode  : request_bar       ,
        rx_header_dw0  : header_dw0        ,
        rx_header_dw1  : header_dw1        ,
        rx_header_dw2  : header_dw2        ,
        rx_header_dw3  : header_dw3        ,
        rx_payload_dw0 : payload_dw0       ,
        tx_valid       : completion_valid  ,
        tx_ready       : completion_ready  ,
        tx_header_dw0  : completion_header0,
        tx_header_dw1  : completion_header1,
        tx_header_dw2  : completion_header2,
        tx_payload_dw0 : completion_payload,
        unsupported                        ,
        malformed                          ,
        display_ctrl                       ,
        display_color                      ,
        display_mode                       ,
        fb_base                            ,
        fb_stride                          ,
        fb_commit_pulse                    ,
    );

    inst tx_adapter: tlp_tx_completion (
        completion_valid                        ,
        completion_data : completion_header0[30],
        header_dw0      : completion_header0    ,
        header_dw1      : completion_header1    ,
        header_dw2      : completion_header2    ,
        payload_dw0     : completion_payload    ,
        tx_wait                                 ,
        completion_ready                        ,
        tx_sop                                  ,
        tx_eop                                  ,
        tx_valid                                ,
        tx_data                                 ,
    );

    // Block later Non-Posted requests from acceptance through Completion.
    assign rx_masknp = !request_ready || (request_valid && !header_dw0[30] && (header_dw0[28:24] == 5'b00000));
}
