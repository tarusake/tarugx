/// PCIe BAR0/BAR2 application core. FB_COMMIT snapshots base/stride.
module tarugx_framebuffer_top (
    tlp_clk         : input  clock     ,
    tlp_rst_n       : input  reset     ,
    completer_id    : input  logic<16> ,
    link_up         : input  logic     ,
    perst_n         : input  logic     ,
    clock_ready     : input  logic<2>  ,
    lane_status     : input  logic<2>  ,
    ltssm           : input  logic<5>  ,
    rx_sop          : input  logic     ,
    rx_eop          : input  logic     ,
    rx_valid        : input  logic<8>  ,
    rx_data         : input  logic<256>,
    rx_bar_decode   : input  logic<6>  ,
    rx_error        : input  logic<8>  ,
    rx_wait         : output logic     ,
    rx_masknp       : output logic     ,
    tx_wait         : input  logic     ,
    tx_sop          : output logic     ,
    tx_eop          : output logic     ,
    tx_valid        : output logic<8>  ,
    tx_data         : output logic<256>,
    led_status      : output logic<4>  ,
    uart_tx_o       : output logic     ,
    display_ctrl    : output logic<32> ,
    display_color   : output logic<32> ,
    committed_base  : output logic<32> ,
    committed_stride: output logic<32> ,
    fb_req_valid    : output logic     ,
    fb_req_ready    : input  logic     ,
    fb_req_write    : output logic     ,
    fb_req_addr     : output logic<32> ,
    fb_req_wdata    : output logic<32> ,
    fb_req_wstrb    : output logic<4>  ,
    fb_rsp_valid    : input  logic     ,
    fb_rsp_ready    : output logic     ,
    fb_rsp_rdata    : input  logic<32> ,
    fb_rsp_error    : input  logic     ,
) {
    var framing_error: logic    ;
    var unsupported  : logic    ;
    var malformed    : logic    ;
    var display_mode : logic<32>;
    var fb_base      : logic<32>;
    var fb_stride    : logic<32>;
    var fb_commit    : logic    ;

    inst app: pcie_gpu_path (
        clk            : tlp_clk  ,
        rst            : tlp_rst_n,
        completer_id              ,
        rx_sop                    ,
        rx_eop                    ,
        rx_valid                  ,
        rx_data                   ,
        rx_bar_decode             ,
        rx_error                  ,
        rx_wait                   ,
        rx_masknp                 ,
        tx_wait                   ,
        tx_sop                    ,
        tx_eop                    ,
        tx_valid                  ,
        tx_data                   ,
        framing_error             ,
        unsupported               ,
        malformed                 ,
        display_ctrl              ,
        display_color             ,
        display_mode              ,
        fb_base                   ,
        fb_stride                 ,
        fb_commit_pulse: fb_commit,
        fb_req_valid              ,
        fb_req_ready              ,
        fb_req_write              ,
        fb_req_addr               ,
        fb_req_wdata              ,
        fb_req_wstrb              ,
        fb_rsp_valid              ,
        fb_rsp_ready              ,
        fb_rsp_rdata              ,
        fb_rsp_error              ,
    );

    always_ff (tlp_clk, tlp_rst_n) {
        if_reset {
            committed_base   = 0;
            committed_stride = 2560;
        } else if fb_commit {
            committed_base   = fb_base;
            committed_stride = fb_stride;
        }
    }

    assign led_status[0] = !tlp_rst_n;
    assign led_status[1] = !link_up;
    assign led_status[2] = !ltssm[0];
    assign led_status[3] = !(framing_error || malformed);

    // UART diagnostics are generated on the board clock by the integration wrapper.
    assign uart_tx_o = 1'b1;
}
