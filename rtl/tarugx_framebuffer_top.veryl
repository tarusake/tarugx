/// PCIe BAR0/BAR2 application core. FB_COMMIT snapshots base/stride.
module tarugx_framebuffer_top #(
    param GPU_VERSION: bit<32> = 32'h0001_0001,
) (
    tlp_clk         : input  clock     ,
    tlp_rst_n       : input  reset     ,
    completer_id    : input  logic<16> ,
    link_up         : input  logic     ,
    perst_n         : input  logic     ,
    clock_ready     : input  logic<2>  ,
    lane_status     : input  logic<2>  ,
    ltssm           : input  logic<5>  ,
    rx_sop          : input  logic     ,
    rx_eop          : input  logic     ,
    rx_valid        : input  logic<8>  ,
    rx_data         : input  logic<256>,
    rx_bar_decode   : input  logic<6>  ,
    rx_error        : input  logic<8>  ,
    rx_wait         : output logic     ,
    rx_masknp       : output logic     ,
    tx_wait         : input  logic     ,
    tx_sop          : output logic     ,
    tx_eop          : output logic     ,
    tx_valid        : output logic<8>  ,
    tx_data         : output logic<256>,
    led_status      : output logic<4>  ,
    uart_tx_o       : output logic     ,
    display_ctrl    : output logic<32> ,
    display_color   : output logic<32> ,
    committed_base  : output logic<32> ,
    committed_stride: output logic<32> ,
    fb_req_valid    : output logic     ,
    fb_req_ready    : input  logic     ,
    fb_req_write    : output logic     ,
    fb_req_addr     : output logic<32> ,
    fb_req_wdata    : output logic<256>,
    fb_req_wstrb    : output logic<32> ,
    fb_rsp_valid    : input  logic     ,
    fb_rsp_ready    : output logic     ,
    fb_rsp_rdata    : input  logic<32> ,
    fb_rsp_error    : input  logic     ,
    active_buffer   : input  logic     ,
    active_fb_base  : input  logic<32> ,
    vblank_toggle   : input  logic     ,
    irq_enable      : output logic<2>  ,
    fill_busy       : input  logic     ,
    fill_done       : input  logic     ,
    fill_error      : input  logic     ,
    blit_busy       : input  logic     ,
    blit_done       : input  logic     ,
    blit_error      : input  logic     ,
    triangle_busy   : input  logic     ,
    triangle_done   : input  logic     ,
    triangle_error  : input  logic     ,
    triangle_writes : input  logic<32> ,
    queue_ready     : input  logic     ,
    queue_level     : input  logic<3>  ,
    queue_active    : input  logic     ,
    queue_completed : input  logic<32> ,
    queue_error     : input  logic     ,
    queue_error_fence: input logic<32> ,
    fill_command    : output logic<128>,
    fill_start      : output logic     ,
    blit_command    : output logic<160>,
    blit_start      : output logic     ,
    triangle_command: output logic<272>,
    triangle_start  : output logic     ,
    queue_command   : output logic<306>,
    queue_submit    : output logic     ,
    queue_clear_error: output logic    ,
) {
    var framing_error: logic    ;
    var unsupported  : logic    ;
    var malformed    : logic    ;
    var display_mode : logic<32>;
    var fb_base      : logic<32>;
    var fb_stride    : logic<32>;
    var fb_commit    : logic    ;

    inst app: pcie_gpu_path #(
        GPU_VERSION,
    ) (
        clk            : tlp_clk  ,
        rst            : tlp_rst_n,
        completer_id              ,
        rx_sop                    ,
        rx_eop                    ,
        rx_valid                  ,
        rx_data                   ,
        rx_bar_decode             ,
        rx_error                  ,
        rx_wait                   ,
        rx_masknp                 ,
        tx_wait                   ,
        tx_sop                    ,
        tx_eop                    ,
        tx_valid                  ,
        tx_data                   ,
        framing_error             ,
        unsupported               ,
        malformed                 ,
        active_buffer             ,
        active_fb_base            ,
        vblank_toggle             ,
        fill_busy                 ,
        fill_done                 ,
        fill_error                ,
        blit_busy                 ,
        blit_done                 ,
        blit_error                ,
        triangle_busy             ,
        triangle_done             ,
        triangle_error            ,
        triangle_writes           ,
        queue_ready               ,
        queue_level               ,
        queue_active              ,
        queue_completed           ,
        queue_error               ,
        queue_error_fence         ,
        display_ctrl              ,
        display_color             ,
        display_mode              ,
        fb_base                   ,
        fb_stride                 ,
        fb_commit_pulse: fb_commit,
        irq_enable                ,
        fill_command              ,
        fill_start                ,
        blit_command              ,
        blit_start                ,
        triangle_command          ,
        triangle_start            ,
        queue_command             ,
        queue_submit              ,
        queue_clear_error         ,
        fb_req_valid              ,
        fb_req_ready              ,
        fb_req_write              ,
        fb_req_addr               ,
        fb_req_wdata              ,
        fb_req_wstrb              ,
        fb_rsp_valid              ,
        fb_rsp_ready              ,
        fb_rsp_rdata              ,
        fb_rsp_error              ,
    );

    always_ff (tlp_clk, tlp_rst_n) {
        if_reset {
            committed_base   = 0;
            committed_stride = 2560;
        } else if fb_commit {
            committed_base   = fb_base;
            committed_stride = fb_stride;
        }
    }

    assign led_status[0] = !tlp_rst_n;
    assign led_status[1] = !link_up;
    assign led_status[2] = !ltssm[0];
    assign led_status[3] = !(framing_error || malformed);

    // UART diagnostics are generated on the board clock by the integration wrapper.
    assign uart_tx_o = 1'b1;
}
