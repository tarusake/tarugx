// SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1
/// Serializes CPU, fill and blit before the timing-critical scanout arbiter.
module render_memory_arbiter (
    clk           : input  clock     ,
    rst_n         : input  reset     ,
    cpu_valid     : input  logic     ,
    cpu_ready     : output logic     ,
    cpu_write     : input  logic     ,
    cpu_addr      : input  logic<22> ,
    cpu_wdata     : input  logic<256>,
    cpu_wstrb     : input  logic<32> ,
    cpu_rsp_valid : output logic     ,
    cpu_rsp_ready : input  logic     ,
    cpu_rsp_data  : output logic<256>,
    cpu_rsp_error : output logic     ,
    fill_valid    : input  logic     ,
    fill_ready    : output logic     ,
    fill_addr     : input  logic<22> ,
    fill_wdata    : input  logic<256>,
    fill_wstrb    : input  logic<32> ,
    fill_rsp_valid: output logic     ,
    fill_rsp_ready: input  logic     ,
    fill_rsp_error: output logic     ,
    blit_valid    : input  logic     ,
    blit_ready    : output logic     ,
    blit_write    : input  logic     ,
    blit_addr     : input  logic<22> ,
    blit_wdata    : input  logic<256>,
    blit_wstrb    : input  logic<32> ,
    blit_rsp_valid: output logic     ,
    blit_rsp_ready: input  logic     ,
    blit_rsp_data : output logic<256>,
    blit_rsp_error: output logic     ,
    out_valid     : output logic     ,
    out_ready     : input  logic     ,
    out_write     : output logic     ,
    out_addr      : output logic<22> ,
    out_wdata     : output logic<256>,
    out_wstrb     : output logic<32> ,
    out_rsp_valid : input  logic     ,
    out_rsp_ready : output logic     ,
    out_rsp_data  : input  logic<256>,
    out_rsp_error : input  logic     ,
) {
    enum State: logic<2> {
        Idle,
        Issue,
        Wait,
        Respond,
    }
    var state         : State     ;
    var owner         : logic<2>  ;
    var preferred     : logic<2>  ;
    var response_data : logic<256>;
    var response_error: logic     ;
    let choose_cpu : logic = cpu_valid && ((preferred == 0) || ((preferred == 1) && !fill_valid && !blit_valid) || ((preferred == 2) && !blit_valid));
    let choose_fill: logic = fill_valid && ((preferred == 1) || ((preferred == 2) && !blit_valid && !cpu_valid) || ((preferred == 0) && !cpu_valid));
    let choose_blit: logic = blit_valid && !choose_cpu && !choose_fill;
    assign cpu_ready      = state == State::Idle && choose_cpu;
    assign fill_ready     = state == State::Idle && choose_fill;
    assign blit_ready     = state == State::Idle && choose_blit;
    assign out_valid      = state == State::Issue;
    assign out_rsp_ready  = state == State::Wait;
    assign cpu_rsp_valid  = state == State::Respond && owner == 0;
    assign fill_rsp_valid = state == State::Respond && owner == 1;
    assign blit_rsp_valid = state == State::Respond && owner == 2;
    assign cpu_rsp_data   = response_data;
    assign cpu_rsp_error  = response_error;
    assign fill_rsp_error = response_error;
    assign blit_rsp_data  = response_data;
    assign blit_rsp_error = response_error;
    always_ff {
        if_reset {
            state          = State::Idle;
            owner          = 0;
            preferred      = 0;
            out_write      = 0;
            out_addr       = 0;
            out_wdata      = 0;
            out_wstrb      = 0;
            response_data  = 0;
            response_error = 0;
        } else {
            case state {
                State::Idle   : if cpu_valid || fill_valid || blit_valid {
                    owner      = if choose_cpu ? 2'd0 : if choose_fill ? 2'd1 : 2'd2;
                    preferred  = if choose_cpu ? 2'd1 : if choose_fill ? 2'd2 : 2'd0;
                    out_write  = if choose_cpu ? cpu_write : if choose_fill ? 1'b1 : blit_write;
                    out_addr   = if choose_cpu ? cpu_addr : if choose_fill ? fill_addr : blit_addr;
                    out_wdata  = if choose_cpu ? cpu_wdata : if choose_fill ? fill_wdata : blit_wdata;
                    out_wstrb  = if choose_cpu ? cpu_wstrb : if choose_fill ? fill_wstrb : blit_wstrb;
                    state       = State::Issue;
                }
                State::Issue  : if out_ready {
                    state = State::Wait;
                }
                State::Wait   : if out_rsp_valid {
                    response_data  = out_rsp_data;
                    response_error = out_rsp_error;
                    state          = State::Respond;
                }
                State::Respond: if (if owner == 0 ? cpu_rsp_ready : if owner == 1 ? fill_rsp_ready : blit_rsp_ready) {
                    state = State::Idle;
                }
                default       : state = State::Idle;
            }
        }
    }
}
