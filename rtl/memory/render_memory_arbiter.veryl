/// Round-robin CPU/fill/blit/triangle admission with ordered responses.
module render_memory_arbiter (
    clk           : input  clock     ,
    rst_n         : input  reset     ,
    cpu_valid     : input  logic     ,
    cpu_ready     : output logic     ,
    cpu_write     : input  logic     ,
    cpu_addr      : input  logic<24> ,
    cpu_wdata     : input  logic<256>,
    cpu_wstrb     : input  logic<32> ,
    cpu_rsp_valid : output logic     ,
    cpu_rsp_ready : input  logic     ,
    cpu_rsp_data  : output logic<256>,
    cpu_rsp_error : output logic     ,
    fill_valid    : input  logic     ,
    fill_ready    : output logic     ,
    fill_addr     : input  logic<24> ,
    fill_wdata    : input  logic<256>,
    fill_wstrb    : input  logic<32> ,
    fill_rsp_valid: output logic     ,
    fill_rsp_ready: input  logic     ,
    fill_rsp_error: output logic     ,
    blit_valid    : input  logic     ,
    blit_ready    : output logic     ,
    blit_write    : input  logic     ,
    blit_addr     : input  logic<24> ,
    blit_wdata    : input  logic<256>,
    blit_wstrb    : input  logic<32> ,
    blit_rsp_valid: output logic     ,
    blit_rsp_ready: input  logic     ,
    blit_rsp_data : output logic<256>,
    blit_rsp_error: output logic     ,
    triangle_valid    : input  logic     ,
    triangle_ready    : output logic     ,
    triangle_write    : input  logic     ,
    triangle_addr     : input  logic<24> ,
    triangle_wdata    : input  logic<256>,
    triangle_wstrb    : input  logic<32> ,
    triangle_rsp_valid: output logic     ,
    triangle_rsp_ready: input  logic     ,
    triangle_rsp_data : output logic<256>,
    triangle_rsp_error: output logic     ,
    out_valid     : output logic     ,
    out_ready     : input  logic     ,
    out_write     : output logic     ,
    out_addr      : output logic<24> ,
    out_wdata     : output logic<256>,
    out_wstrb     : output logic<32> ,
    out_rsp_valid : input  logic     ,
    out_rsp_ready : output logic     ,
    out_rsp_data  : input  logic<256>,
    out_rsp_error : input  logic     ,
) {
    var issuing       : logic         ;
    var preferred     : logic<2>      ;
    var owners        : logic<2>   [8];
    var writes        : logic      [8];
    var head          : logic<3>      ;
    var tail          : logic<3>      ;
    var count         : logic<4>      ;
    var write_count   : logic<4>      ;
    var response_valid: logic         ;
    var response_owner: logic<2>      ;
    var response_data : logic<256>    ;
    var response_error: logic         ;
    let cpu_eligible : logic = cpu_valid && (cpu_write || (write_count == 0));
    let fill_eligible: logic = fill_valid;
    let blit_eligible: logic = blit_valid && (blit_write || (write_count == 0));
    let triangle_eligible: logic = triangle_valid
        && (triangle_write || (write_count == 0));
    let read_waiting: logic = (cpu_valid && !cpu_write)
        || (blit_valid && !blit_write)
        || (triangle_valid && !triangle_write);
    let choose_cpu : logic = cpu_eligible && ((preferred == 0)
        || ((preferred == 1) && !fill_eligible && !blit_eligible && !triangle_eligible)
        || ((preferred == 2) && !blit_eligible && !triangle_eligible)
        || ((preferred == 3) && !triangle_eligible));
    let choose_fill: logic = fill_eligible && ((preferred == 1)
        || ((preferred == 2) && !blit_eligible && !triangle_eligible && !cpu_eligible)
        || ((preferred == 3) && !triangle_eligible && !cpu_eligible)
        || ((preferred == 0) && !cpu_eligible));
    let choose_blit: logic = blit_eligible && ((preferred == 2)
        || ((preferred == 3) && !triangle_eligible && !cpu_eligible && !fill_eligible)
        || ((preferred == 0) && !cpu_eligible && !fill_eligible)
        || ((preferred == 1) && !fill_eligible));
    let choose_triangle: logic = triangle_eligible && !choose_cpu && !choose_fill && !choose_blit;
    let selected_write: logic = if choose_cpu ? cpu_write
        : if choose_fill ? 1'b1 : if choose_blit ? blit_write : triangle_write;
    let issue_accept: logic = issuing && out_ready;
    // Keep posted writes pipelined, but do not let a following read overtake
    // their actual DDR commit. The response pipeline preserves command order,
    // yet the native write response is generated when the command is accepted.
    let capacity: logic = (count <: 8) && (!issuing || out_ready)
        && !((write_count != 0) && read_waiting);
    assign cpu_ready      = capacity && choose_cpu;
    assign fill_ready     = capacity && choose_fill;
    assign blit_ready     = capacity && choose_blit;
    assign triangle_ready = capacity && choose_triangle;
    let push: logic = (cpu_valid && cpu_ready) || (fill_valid && fill_ready)
        || (blit_valid && blit_ready) || (triangle_valid && triangle_ready);
    assign out_valid      = issuing;
    assign cpu_rsp_valid  = response_valid && (response_owner == 0);
    assign fill_rsp_valid = response_valid && (response_owner == 1);
    assign blit_rsp_valid = response_valid && (response_owner == 2);
    assign triangle_rsp_valid = response_valid && (response_owner == 3);
    assign triangle_rsp_data = response_data;
    assign cpu_rsp_data   = response_data;
    assign cpu_rsp_error  = response_error;
    assign fill_rsp_error = response_error;
    assign blit_rsp_data  = response_data;
    assign blit_rsp_error = response_error;
    assign triangle_rsp_error = response_error;
    let response_accept: logic = response_valid
        && (if response_owner == 0 ? cpu_rsp_ready
            : if response_owner == 1 ? fill_rsp_ready
            : if response_owner == 2 ? blit_rsp_ready : triangle_rsp_ready);
    assign out_rsp_ready = (count != 0) && (!response_valid || response_accept);
    let pop: logic = out_rsp_valid && out_rsp_ready;
    let head_write: logic = writes[head];
    always_ff {
        if_reset {
            issuing        = 0;
            preferred      = 0;
            owners         = '{default: '0};
            writes         = '{default: '0};
            head           = 0;
            tail           = 0;
            count          = 0;
            write_count    = 0;
            response_valid = 0;
            response_owner = 0;
            out_write      = 0;
            out_addr       = 0;
            out_wdata      = 0;
            out_wstrb      = 0;
            response_data  = 0;
            response_error = 0;
        } else {
            if issue_accept {
                issuing = 0;
            }
            if push {
                issuing     = 1;
                owners[tail] = if choose_cpu ? 2'd0 : if choose_fill ? 2'd1
                    : if choose_blit ? 2'd2 : 2'd3;
                writes[tail] = selected_write;
                tail         = tail + 3'd1;
                preferred    = if choose_cpu ? 2'd1 : if choose_fill ? 2'd2
                    : if choose_blit ? 2'd3 : 2'd0;
                out_write    = if choose_cpu ? cpu_write : if choose_fill ? 1'b1
                    : if choose_blit ? blit_write : triangle_write;
                out_addr     = if choose_cpu ? cpu_addr : if choose_fill ? fill_addr
                    : if choose_blit ? blit_addr : triangle_addr;
                out_wdata    = if choose_cpu ? cpu_wdata : if choose_fill ? fill_wdata
                    : if choose_blit ? blit_wdata : triangle_wdata;
                out_wstrb    = if choose_cpu ? cpu_wstrb : if choose_fill ? fill_wstrb
                    : if choose_blit ? blit_wstrb : triangle_wstrb;
            }
            if push && selected_write && !(pop && head_write) {
                write_count = write_count + 4'd1;
            } else if pop && head_write && !(push && selected_write) {
                write_count = write_count - 4'd1;
            }
            if pop {
                response_valid = 1;
                response_owner = owners[head];
                response_data  = out_rsp_data;
                response_error = out_rsp_error;
                head           = head + 3'd1;
            } else if response_accept {
                response_valid = 0;
            }
            if push && !pop {
                count = count + 4'd1;
            } else if pop && !push {
                count = count - 4'd1;
            }
        }
    }
}
