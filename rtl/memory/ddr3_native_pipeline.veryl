/// 1:4 BL8 native interface, with eight reserved in-order response slots.
/// Read returns have no backpressure: every issued command owns storage first.
/// IPUG281 4.4.8 guarantees read returns in command order for 1:4 mode.
module ddr3_native_pipeline (
    clk          : input  clock     ,
    rst_n        : input  reset     ,
    calibrated   : input  logic     ,
    mem_valid    : input  logic     ,
    mem_ready    : output logic     ,
    mem_write    : input  logic     ,
    mem_addr     : input  logic<22> ,
    mem_wdata    : input  logic<256>,
    mem_wstrb    : input  logic<32> ,
    mem_rsp_valid: output logic     ,
    mem_rsp_ready: input  logic     ,
    mem_rsp_data : output logic<256>,
    mem_rsp_error: output logic     ,
    cmd_ready    : input  logic     ,
    cmd          : output logic<3>  ,
    cmd_en       : output logic     ,
    addr         : output logic<29> ,
    wr_data_rdy  : input  logic     ,
    wr_data      : output logic<256>,
    wr_data_en   : output logic     ,
    wr_data_end  : output logic     ,
    wr_data_mask : output logic<32> ,
    rd_data      : input  logic<256>,
    rd_data_valid: input  logic     ,
    rd_data_end  : input  logic     ,
) {
    var issuing: logic;
    var write: logic;
    var issue_slot: logic<3>;
    var head: logic<3>;
    var tail: logic<3>;
    var count: logic<4>;
    var done: logic [8];
    var errors: logic [8];
    var data: logic<256> [8];
    var read_slots: logic<3> [8];
    var read_head: logic<3>;
    var read_tail: logic<3>;
    var read_count: logic<4>;
    assign mem_ready = calibrated && !issuing && (count <: 8);
    assign mem_rsp_valid = (count != 0) && done[head];
    assign mem_rsp_data = data[head];
    assign mem_rsp_error = errors[head];
    assign cmd = if write ? 3'b000 : 3'b001;
    assign cmd_en = issuing && calibrated && cmd_ready && (!write || wr_data_rdy);
    assign wr_data_en = cmd_en && write;
    assign wr_data_end = wr_data_en;
    let accept: logic = mem_valid && mem_ready;
    let pop: logic = mem_rsp_valid && mem_rsp_ready;
    let read_issue: logic = cmd_en && !write;
    let read_return: logic = rd_data_valid && ((read_count != 0) || read_issue);
    let return_slot: logic<3> = if read_count != 0 ? read_slots[read_head] : issue_slot;
    always_ff {
        if_reset {
            issuing = 0; write = 0; issue_slot = 0;
            head = 0; tail = 0; count = 0;
            done = '{default: '0}; errors = '{default: '0}; data = '{default: '0};
            read_slots = '{default: '0}; read_head = 0; read_tail = 0; read_count = 0;
            addr = 0; wr_data = 0; wr_data_mask = '1;
        } else {
            if accept {
                issue_slot = tail; tail = tail + 3'd1;
                write = mem_write; addr = {9'b0, mem_addr[21:2]};
                wr_data = mem_wdata; wr_data_mask = ~mem_wstrb;
                data[tail] = 0;
                errors[tail] = mem_addr[4:0] != 0;
                done[tail] = mem_addr[4:0] != 0;
                issuing = mem_addr[4:0] == 0;
            }
            if cmd_en {
                issuing = 0;
                if write { done[issue_slot] = 1; }
            }
            if read_issue {
                read_slots[read_tail] = issue_slot; read_tail = read_tail + 3'd1;
            }
            if read_return {
                data[return_slot] = rd_data;
                errors[return_slot] = !rd_data_end;
                done[return_slot] = 1;
                read_head = read_head + 3'd1;
            }
            if read_issue && !read_return { read_count = read_count + 4'd1; }
            else if read_return && !read_issue { read_count = read_count - 4'd1; }
            if pop { done[head] = 0; head = head + 3'd1; }
            if accept && !pop { count = count + 4'd1; }
            else if pop && !accept { count = count - 4'd1; }
        }
    }
}
