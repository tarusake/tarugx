/// CPU DWORD mailbox -> lane bridge -> CPU/scanout arbiter.
/// Resets must assert together; release is synchronized by the caller.
module framebuffer_memory_pipeline (
    cpu_clk       : input  'cpu clock     ,
    cpu_rst_n     : input  'cpu reset     ,
    cpu_valid     : input  'cpu logic     ,
    cpu_ready     : output 'cpu logic     ,
    cpu_request   : input  'cpu logic<69> ,
    cpu_rsp_valid : output 'cpu logic     ,
    cpu_rsp_ready : input  'cpu logic     ,
    cpu_response  : output 'cpu logic<33> ,
    mem_clk       : input  'mem clock     ,
    mem_rst_n     : input  'mem reset     ,
    scan_valid    : input  'mem logic     ,
    scan_ready    : output 'mem logic     ,
    scan_addr     : input  'mem logic<22> ,
    scan_rsp_valid: output 'mem logic     ,
    scan_rsp_ready: input  'mem logic     ,
    scan_rsp_data : output 'mem logic<256>,
    scan_rsp_error: output 'mem logic     ,
    mem_valid     : output 'mem logic     ,
    mem_ready     : input  'mem logic     ,
    mem_write     : output 'mem logic     ,
    mem_addr      : output 'mem logic<22> ,
    mem_wdata     : output 'mem logic<256>,
    mem_wstrb     : output 'mem logic<32> ,
    mem_rsp_valid : input  'mem logic     ,
    mem_rsp_ready : output 'mem logic     ,
    mem_rsp_data  : input  'mem logic<256>,
    mem_rsp_error : input  'mem logic     ,
) {
    var d_valid       : 'mem logic     ;
    var d_ready       : 'mem logic     ;
    var d_request     : 'mem logic<69> ;
    var d_rsp_valid   : 'mem logic     ;
    var d_rsp_ready   : 'mem logic     ;
    var d_response    : 'mem logic<33> ;
    var lane_valid    : 'mem logic     ;
    var lane_ready    : 'mem logic     ;
    var lane_write    : 'mem logic     ;
    var lane_addr     : 'mem logic<22> ;
    var lane_wdata    : 'mem logic<256>;
    var lane_wstrb    : 'mem logic<32> ;
    var lane_rsp_valid: 'mem logic     ;
    var lane_rsp_ready: 'mem logic     ;
    var lane_rsp_data : 'mem logic<256>;
    var lane_rsp_error: 'mem logic     ;
    inst cdc: memory_request_cdc (
        src_clk      : cpu_clk      ,
        src_rst_n    : cpu_rst_n    ,
        src_valid    : cpu_valid    ,
        src_ready    : cpu_ready    ,
        src_request  : cpu_request  ,
        src_rsp_valid: cpu_rsp_valid,
        src_rsp_ready: cpu_rsp_ready,
        src_response : cpu_response ,
        dst_clk      : mem_clk      ,
        dst_rst_n    : mem_rst_n    ,
        dst_valid    : d_valid      ,
        dst_ready    : d_ready      ,
        dst_request  : d_request    ,
        dst_rsp_valid: d_rsp_valid  ,
        dst_rsp_ready: d_rsp_ready  ,
        dst_response : d_response   ,
    );
    inst lanes: framebuffer_bridge (
        clk          : mem_clk         ,
        rst_n        : mem_rst_n       ,
        req_valid    : d_valid         ,
        req_ready    : d_ready         ,
        req_write    : d_request[68]   ,
        req_addr     : d_request[67:36],
        req_wdata    : d_request[35:4] ,
        req_wstrb    : d_request[3:0]  ,
        rsp_valid    : d_rsp_valid     ,
        rsp_ready    : d_rsp_ready     ,
        rsp_rdata    : d_response[31:0],
        rsp_error    : d_response[32]  ,
        mem_valid    : lane_valid      ,
        mem_ready    : lane_ready      ,
        mem_write    : lane_write      ,
        mem_addr     : lane_addr       ,
        mem_wdata    : lane_wdata      ,
        mem_wstrb    : lane_wstrb      ,
        mem_rsp_valid: lane_rsp_valid  ,
        mem_rsp_ready: lane_rsp_ready  ,
        mem_rsp_data : lane_rsp_data   ,
        mem_rsp_error: lane_rsp_error  ,
    );
    inst arbiter: memory_arbiter_pipelined (
        clk           : mem_clk       ,
        rst_n         : mem_rst_n     ,
        cpu_valid     : lane_valid    ,
        cpu_ready     : lane_ready    ,
        cpu_write     : lane_write    ,
        cpu_addr      : lane_addr     ,
        cpu_wdata     : lane_wdata    ,
        cpu_wstrb     : lane_wstrb    ,
        cpu_rsp_valid : lane_rsp_valid,
        cpu_rsp_ready : lane_rsp_ready,
        cpu_rsp_data  : lane_rsp_data ,
        cpu_rsp_error : lane_rsp_error,
        scan_valid                    ,
        scan_ready                    ,
        scan_addr                     ,
        scan_rsp_valid                ,
        scan_rsp_ready                ,
        scan_rsp_data                 ,
        scan_rsp_error                ,
        mem_valid                     ,
        mem_ready                     ,
        mem_write                     ,
        mem_addr                      ,
        mem_wdata                     ,
        mem_wstrb                     ,
        mem_rsp_valid                 ,
        mem_rsp_ready                 ,
        mem_rsp_data                  ,
        mem_rsp_error                 ,
    );
}
