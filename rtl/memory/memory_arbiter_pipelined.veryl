/// Round-robin admission, eight ordered ownership slots, one held command.
/// No Scanout priority tuning: overlap read latency while preserving CPU order.
module memory_arbiter_pipelined (
    clk           : input  clock     ,
    rst_n         : input  reset     ,
    cpu_valid     : input  logic     ,
    cpu_ready     : output logic     ,
    cpu_write     : input  logic     ,
    cpu_addr      : input  logic<22> ,
    cpu_wdata     : input  logic<256>,
    cpu_wstrb     : input  logic<32> ,
    cpu_rsp_valid : output logic     ,
    cpu_rsp_ready : input  logic     ,
    cpu_rsp_data  : output logic<256>,
    cpu_rsp_error : output logic     ,
    scan_valid    : input  logic     ,
    scan_ready    : output logic     ,
    scan_addr     : input  logic<22> ,
    scan_rsp_valid: output logic     ,
    scan_rsp_ready: input  logic     ,
    scan_rsp_data : output logic<256>,
    scan_rsp_error: output logic     ,
    mem_valid     : output logic     ,
    mem_ready     : input  logic     ,
    mem_write     : output logic     ,
    mem_addr      : output logic<22> ,
    mem_wdata     : output logic<256>,
    mem_wstrb     : output logic<32> ,
    mem_rsp_valid : input  logic     ,
    mem_rsp_ready : output logic     ,
    mem_rsp_data  : input  logic<256>,
    mem_rsp_error : input  logic     ,
) {
    var issuing: logic;
    var prefer_scan: logic;
    var owners: logic [8];
    var head: logic<3>;
    var tail: logic<3>;
    var count: logic<4>;
    let choose_scan: logic = scan_valid && (!cpu_valid || prefer_scan);
    let capacity: logic = !issuing && (count <: 8);
    assign scan_ready = capacity && choose_scan;
    assign cpu_ready = capacity && !choose_scan;
    assign mem_valid = issuing;
    assign scan_rsp_valid = (count != 0) && mem_rsp_valid && owners[head];
    assign cpu_rsp_valid = (count != 0) && mem_rsp_valid && !owners[head];
    assign scan_rsp_data = mem_rsp_data;
    assign cpu_rsp_data = mem_rsp_data;
    assign scan_rsp_error = mem_rsp_error;
    assign cpu_rsp_error = mem_rsp_error;
    assign mem_rsp_ready = (count != 0) && (if owners[head] ? scan_rsp_ready : cpu_rsp_ready);
    let push: logic = (scan_valid && scan_ready) || (cpu_valid && cpu_ready);
    let pop: logic = mem_rsp_valid && mem_rsp_ready;
    always_ff {
        if_reset {
            issuing = 0; prefer_scan = 1; owners = '{default: '0};
            head = 0; tail = 0; count = 0;
            mem_write = 0; mem_addr = 0; mem_wdata = 0; mem_wstrb = 0;
        } else {
            if issuing && mem_ready { issuing = 0; }
            if push {
                issuing = 1; owners[tail] = choose_scan; tail = tail + 3'd1;
                prefer_scan = !choose_scan;
                mem_write = !choose_scan && cpu_write;
                mem_addr = if choose_scan ? scan_addr : cpu_addr;
                mem_wdata = if choose_scan ? 256'b0 : cpu_wdata;
                mem_wstrb = if choose_scan ? 32'b0 : cpu_wstrb;
            }
            if pop { head = head + 3'd1; }
            if push && !pop { count = count + 4'd1; }
            else if pop && !push { count = count - 4'd1; }
        }
    }
}
