diff --git a/src/gallium/winsys/sw/kms-dri/kms_dri_sw_winsys.c b/src/gallium/winsys/sw/kms-dri/kms_dri_sw_winsys.c
--- a/src/gallium/winsys/sw/kms-dri/kms_dri_sw_winsys.c
+++ b/src/gallium/winsys/sw/kms-dri/kms_dri_sw_winsys.c
@@ -52 +52,4 @@
 #include "util/simple_mtx.h"
+#ifdef HAVE_TARUGX
+#include "tarugx/tarugx_drm.h"
+#endif
@@ -135,3 +138,4 @@ kms_sw_displaytarget_create(struct sw_winsys *ws,
    struct drm_mode_create_dumb create_req;
    struct drm_mode_destroy_dumb destroy_req;
+   bool allocated = false;
    int ret;
@@ -153,8 +157,41 @@ kms_sw_displaytarget_create(struct sw_winsys *ws,
    create_req.bpp = util_format_get_blocksizebits(format);
    create_req.width = width;
    create_req.height = height;
-   ret = drmIoctl(kms_sw->fd, DRM_IOCTL_MODE_CREATE_DUMB, &create_req);
-   if (ret) {
-      fprintf(stderr, "KMS: DRM_IOCTL_MODE_CREATE_DUMB failed: %s\n", strerror(errno));
-      goto free_bo;
+#ifdef HAVE_TARUGX
+   if (format == PIPE_FORMAT_B5G6R5_UNORM && width == 1920 &&
+       height == 1080) {
+      drmVersionPtr version = drmGetVersion(kms_sw->fd);
+      bool is_tarugx = version && version->name_len == 6 &&
+                       !memcmp(version->name, "tarugx", 6);
+
+      drmFreeVersion(version);
+      if (is_tarugx) {
+         struct drm_tarugx_vram_create create_vram = {
+            .width = width,
+            .height = height,
+            .flags = DRM_TARUGX_VRAM_FRONT | DRM_TARUGX_VRAM_DEPTH,
+         };
+
+         if (drmIoctl(kms_sw->fd, DRM_IOCTL_TARUGX_VRAM_CREATE,
+                      &create_vram) && errno == EOPNOTSUPP) {
+            create_vram.flags = DRM_TARUGX_VRAM_FRONT;
+            drmIoctl(kms_sw->fd, DRM_IOCTL_TARUGX_VRAM_CREATE,
+                     &create_vram);
+         }
+         if (create_vram.handle) {
+            create_req.handle = create_vram.handle;
+            create_req.pitch = create_vram.pitch;
+            create_req.size = create_vram.size;
+            allocated = true;
+         }
+      }
+   }
+#endif
+   if (!allocated) {
+      ret = drmIoctl(kms_sw->fd, DRM_IOCTL_MODE_CREATE_DUMB, &create_req);
+      if (ret) {
+         fprintf(stderr, "KMS: DRM_IOCTL_MODE_CREATE_DUMB failed: %s\n",
+                 strerror(errno));
+         goto free_bo;
+      }
    }
